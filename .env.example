# Mini-Agent Environment Configuration Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED CONFIGURATION (You MUST set these)
# =============================================================================

# MiniMax API Key (Required for core functionality)
# Get from: https://platform.minimax.io/
MINIMAX_API_KEY=your_minimax_api_key_here

# =============================================================================
# OPTIONAL CONFIGURATION (Defaults provided, but you can override)
# =============================================================================

# Z.AI API Key (Optional - for web search functionality)
# Get from: https://z.ai/ (FREE tier: 100 searches + 100 readers per day)
ZAI_API_KEY=your_zai_api_key_here

# =============================================================================
# LLM PROVIDER OVERRIDES (Optional)
# =============================================================================

# MiniMax API Base URL (default: https://api.minimax.io)
# For China users: https://api.minimaxi.com
MINIMAX_API_BASE=https://api.minimax.io

# Model to use (default: MiniMax-M2)
MINIMAX_MODEL=MiniMax-M2

# Maximum tokens per request (default: 200000)
MINIMAX_MAX_TOKENS=200000

# Temperature for creativity (default: 0.7, range: 0.0-2.0)
MINIMAX_TEMPERATURE=0.7

# =============================================================================
# APPLICATION OVERRIDES (Optional)
# =============================================================================

# Debug mode (default: false)
MINIMAX_DEBUG=false

# Log level (default: INFO, options: DEBUG, INFO, WARNING, ERROR)
MINIMAX_LOG_LEVEL=INFO

# Workspace directory (default: ./workspace)
MINIMAX_WORKSPACE_DIR=./workspace

# =============================================================================
# SECURITY SETTINGS (Optional)
# =============================================================================

# Maximum steps per session (default: 50)
MINIMAX_MAX_STEPS=50

# Enable credit protection (default: true)
MINIMAX_ENABLE_CREDIT_PROTECTION=true

# Maximum tools per session (default: 100)
MINIMAX_MAX_TOOLS_PER_SESSION=100

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================

# For production deployment, use environment variables or secret management:
# - Docker: Use environment variables in docker-compose.yml
# - Kubernetes: Use ConfigMaps and Secrets
# - Cloud: Use AWS Secrets Manager, Azure Key Vault, or GCP Secret Manager
# - Local: Use .env file (already in .gitignore)

# NEVER commit real API keys to version control!
# The .env file is automatically ignored by .gitignore

# =============================================================================
# VALIDATION
# =============================================================================

# Test your configuration by running:
# python -c "from mini_agent.config import get_config; print(get_config().health_check())"

# This will validate your configuration and report any issues.
